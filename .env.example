# Copy this file to .env and fill in the values.
# JWT_SECRET is required. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional. Without them, email (OTP / password reset), VNPay and the chatbot won't work.
MAIL_USERNAME=
MAIL_PASSWORD=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
GEMINI_API_KEY=

# Host or IP people type in the browser to open the site. Leave empty for localhost.
# Set it when Docker runs on another machine, e.g. PUBLIC_HOST=192.168.1.50
# (changing it requires a rebuild: docker compose build travelweb admin)
PUBLIC_HOST=

# Optional: host port for MySQL if 3307 is taken
# MYSQL_HOST_PORT=3310
