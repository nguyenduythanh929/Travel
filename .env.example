# Copy this file to .env and fill in the values.
# JWT_SECRET is required. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional. Without them, email (OTP / password reset), VNPay and the chatbot won't work.
MAIL_USERNAME=
MAIL_PASSWORD=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
GEMINI_API_KEY=
